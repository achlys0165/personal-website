{
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "isolatedModules": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "api/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts"
  ]
}
