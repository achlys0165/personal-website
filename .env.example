# Public Cloudflare Turnstile site key (the only key exposed to the browser).
VITE_TURNSTILE_SITE_KEY=

# Server-only credentials: add these privately in Vercel project settings.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# A sender address on your verified Resend domain, e.g. Jan <contact@your-domain.com>.
CONTACT_FROM_EMAIL=
# Exact website origins, comma-separated. No path or trailing slash required.
CONTACT_ALLOWED_ORIGINS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
